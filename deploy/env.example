# =================================================================
# Hayden Xue 博客系统 - 生产环境配置文件 (.env)
# 复制此文件为 .env 并根据你的实际设置修改密码与公网 IP:
# cp deploy/env.example .env
# =================================================================

# -----------------------------
# 1. 域名与主机网络
# -----------------------------
# 你的腾讯云公网 IP 或已绑定的域名 (例如 123.45.67.89 或 blog.hayden.com)
SERVER_HOST=127.0.0.1
HTTP_PORT=80

# -----------------------------
# 2. MySQL 生产数据库配置
# -----------------------------
DB_NAME=hayden_blog
DB_USER=hayden
DB_PASS=HaydenPass_2026!Sec
MYSQL_ROOT_PASSWORD=HaydenRoot_2026!Sec
DB_HOST=mysql
DB_PORT=3306

# -----------------------------
# 3. Redis 生产缓存配置
# -----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=HaydenRedis_2026!Sec

# -----------------------------
# 4. MinIO 对象存储配置
# -----------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=HaydenMinio_2026!Sec
MINIO_BUCKET=hayden-blog
# 容器内后端访问 MinIO 的内网地址
MINIO_ENDPOINT=http://minio:9000
# 浏览器公网访问 MinIO 媒体资源的地址 (若未绑定域名则用 http://${SERVER_HOST}:9000)
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# -----------------------------
# 5. JWT 安全鉴权秘钥 (必须为长随机字符串)
# -----------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# -----------------------------
# 6. 前端 SSR 内部网络通信
# -----------------------------
# Next.js 服务端渲染 (SSR) 请求后端的内部容器地址
INTERNAL_API_BASE=http://backend:8080
# 浏览器客户端请求 API 路径 (空字符串表示走当前同源 /api 相对路径，由 Nginx 反代)
NEXT_PUBLIC_API_BASE=

# -----------------------------
# 7. AI 辅助模型配置 (可选)
# -----------------------------
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
